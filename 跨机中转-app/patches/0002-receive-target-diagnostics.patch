+#[tokio::test]
+async fn test_missing_upload_target_reports_application_failure() {
+    assert_application_target_failure(1, "did not provide a save target").await;
+}
+
+#[tokio::test]
+async fn test_closed_stream_preserves_application_failure() {
+    assert_application_target_failure(2, "receive session missing").await;
+}
+
+async fn assert_application_target_failure(mode: u8, expected: &str) {
+    let server = start_test_server_with_target_mode(None, true, None, true, mode).await;
+    let client = LsHttpClientV2::try_new_without_cert().unwrap();
+    let response = client.prepare_upload(
+        ProtocolType::Http, "127.0.0.1", server.port, None,
+        prepare_upload_request(&[file_dto("file-a", "a.bin", 5)]),
+        None, CancellationToken::new(),
+    ).await.unwrap().response.unwrap();
+    let result = upload_bytes(
+        &client, server.port, &response.session_id,
+        "file-a", &response.files["file-a"], b"hello",
+    ).await;
+    let Err(ClientError::StatusCode(err)) = result else {
+        panic!("expected status error, got {result:?}");
+    };
+    assert_eq!(err.status, 500);
+    assert!(err.message.as_deref().unwrap_or("").contains(expected), "{err:?}");
+}
+
 /// A save target that cannot be opened (the save "directory" is a regular
 /// file) fails the upload with a 500 whose body carries the underlying
 /// reason, so the sender can show it instead of a bare status code.
